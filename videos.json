---
permalink: /videos.json
---
[
{%- assign vids = site.static_files | where_exp: "f", "f.extname == '.mp4' or f.extname == '.webm' or f.extname == '.ogg' or f.extname == '.mov' or f.extname == '.m4v'" | sort: "name" -%}
{%- for f in vids -%}
  {"name": {{ f.name | jsonify }}}
  {%- unless forloop.last -%},{%- endunless -%}
{%- endfor -%}
]